# Read by script-helpers build_rpm_artifacts.sh (sourced). The version is
# the VERSION file, which a release branch bumps to the tag it releases, with
# "-" as "~" (RPM forbids "-" in Version; 0.15.0~rc1 sorts before 0.15.0).
APP_NAME=agentvault
APP_VERSION="$(tr -d '[:space:]' < "$(dirname "${BASH_SOURCE[0]}")/../VERSION" | tr '-' '~')"
